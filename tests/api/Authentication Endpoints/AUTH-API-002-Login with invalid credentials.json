{
    "testCaseId": "AUTH-API-002",
    "testCaseName": "Login with invalid credentials",
    "request": {
        "method": "POST",
        "endpoint": "/auth/login",
        "headers": {
            "Content-Type": "application/json"
        },
        "payload": {
            "email": "alice@flashguard.local",
            "password": "WrongPassword"
        }
    },
    "expectedResponse": {
        "statusCode": [400, 401],
        "body": {
            "message": "Invalid credentials"
        }
    }
}