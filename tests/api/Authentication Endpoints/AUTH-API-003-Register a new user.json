{
    "testCaseId": "AUTH-API-003",
    "testCaseName": "Register a new user",
    "request": {
        "method": "POST",
        "endpoint": "/auth/register",
        "headers": {
            "Content-Type": "application/json"
        },
        "payload": {
            "email": "Dikela@flashguard.local",
            "fullName": "Dikela Mpatho",
            "password": "offline-demo"
        }
    },
    "expectedResponse": {
        "statusCode": 201,
        "body": {
            "user": {
                "id": 7,
                "email": "Dikela@flashguard.local",
                "full_name": "Dikela Mpatho",
                "balance": 0,
                "is_active": true
            }
        }
    }
}