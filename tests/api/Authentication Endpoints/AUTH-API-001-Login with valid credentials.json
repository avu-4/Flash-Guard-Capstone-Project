{
    "testCaseId": "AUTH-API-001",
    "testCaseName": "Login with valid credentials",
    "request": {
        "method": "POST",
        "endpoint": "/auth/login",
        "headers": {
            "Content-Type": "application/json"
        },
        "payload": {
            "email": "alice@flashguard.local",
            "password": "offline-demo"
        }
    },
    "expectedResponse": {
        "statusCode": 200,
        "body": {
            "token": "non-empty value",
            "user": {
                "id": 1,
                "email": "alice@flashguard.local",
                "full_name": "Alice Ledger",
                "is_active": true
            } 
        }
    }
}