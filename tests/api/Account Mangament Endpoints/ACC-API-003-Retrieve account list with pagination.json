    "testResult": {
        "status": "Failed",
        "expectedRecordCount": 2,
        "actualRecordCount": 7,
        "defectDescription": "The API returned seven account records instead of respecting the requested pagination limit of two.",
        "finding": "Pagination does not appear to be functioning as expected.",
        "remarks": "Confirm that page and limit are the documented pagination parameters before formally raising the defect."
    }
